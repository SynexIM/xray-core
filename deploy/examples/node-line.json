{
  // 专线入口只接可信中转；防火墙限制中转源地址。中转必须发送 PROXY protocol。
  // 部署前替换所有凭据占位；VLESS/VMess UUID、Mixed 用户名口令、SS2022 密钥分别独立。
  "log": { "loglevel": "warning" },
  "api": {
    "tag": "api",
    "listen": "/run/xray/api.sock",
    "services": ["HandlerService", "RoutingService", "StatsService", "PolicyService", "CapabilityService", "LimitService"]
  },
  // LimitService 等甲路合并后可用；此处暂不放 limit 段，合并后由 agent 下发规则。
  "stats": {},
  "policy": {
    "levels": { "1": { "connIdle": 300, "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true, "statsOutboundUplink": true, "statsOutboundDownlink": true }
  },
  "inbounds": [
    {
      "tag": "line-vless",
      "listen": "0.0.0.0",
      "port": 10443,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "11111111-1111-4111-8111-111111111111", "email": "line-001-vless", "level": 1, "flow": "xtls-rprx-vision" }],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "sockopt": { "acceptProxyProtocol": true },
        "realitySettings": {
          "target": "www.cloudflare.com:443",
          "serverNames": ["www.cloudflare.com"],
          // 运行 xray x25519，填入 PrivateKey；公钥交给客户端。此字符串只是占位说明。
          "privateKey": "REPLACE_WITH_XRAY_X25519_PRIVATE_KEY",
          "shortIds": ["a1b2c3d4e5f60718"]
        }
      }
    },
    {
      "tag": "line-vmess",
      "listen": "0.0.0.0",
      "port": 10001,
      "protocol": "vmess",
      "settings": { "clients": [{ "id": "22222222-2222-4222-8222-222222222222", "email": "line-001-vmess", "level": 1 }] },
      "streamSettings": { "network": "tcp", "sockopt": { "acceptProxyProtocol": true } }
    },
    {
      "tag": "line-mixed",
      "listen": "0.0.0.0",
      "port": 10002,
      "protocol": "mixed",
      "settings": {
        "auth": "password",
        "accounts": [{ "user": "replace-line-mixed-user", "pass": "REPLACE_WITH_INDEPENDENT_MIXED_PASSWORD", "email": "line-001-mixed" }],
        // PROXY protocol 只保护 TCP，此模板不开放未经中转的 UDP。
        "udp": false,
        "userLevel": 1
      },
      "streamSettings": { "network": "tcp", "sockopt": { "acceptProxyProtocol": true } }
    },
    {
      "tag": "line-ss2022",
      "listen": "0.0.0.0",
      "port": 10003,
      "protocol": "shadowsocks",
      "settings": {
        "method": "2022-blake3-aes-128-gcm",
        // 服务端与客户端分别生成独立 16 字节随机密钥并用标准 Base64 编码；以下只作长度合法的占位。
        "password": "AAAAAAAAAAAAAAAAAAAAAA==",
        "clients": [{ "password": "AQEBAQEBAQEBAQEBAQEBAQ==", "email": "line-001-ss", "level": 1 }],
        "network": "tcp"
      },
      "streamSettings": { "network": "tcp", "sockopt": { "acceptProxyProtocol": true } }
    }
  ],
  "outbounds": [{ "tag": "direct", "protocol": "freedom", "settings": { "domainStrategy": "ForceIPv4" } }]
}
